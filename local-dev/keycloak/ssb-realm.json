{
  "realm": "ssb",
  "displayName": "SSB local development",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 300,

  "clients": [
    {
      "clientId": "metamapper-datadoc-m2m",
      "name": "Local MetaMapper to Datadoc",
      "description": "Local equivalent of metamapper-datadoc-m2m from keycloak-iac",

      "enabled": true,
      "protocol": "openid-connect",

      "clientAuthenticatorType": "client-secret",
      "secret": "${METAMAPPER_LOCAL_CLIENT_SECRET}",

      "publicClient": false,
      "bearerOnly": false,

      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,

      "fullScopeAllowed": false,

      "protocolMappers": [
        {
          "name": "metamapper-subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "sub",
            "claim.value": "metamapper",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "datadoc-role",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "claim.value": "DATA_FILE_CREATOR",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "datadoc-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "datadoc",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ]
}